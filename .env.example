# ---- Razorpay (TEST MODE ONLY) -------------------------------------------------
# Dashboard -> Settings -> API Keys -> Generate Test Key. Keys start with rzp_test_.
# Leave both blank and the agent runs against the in-memory fixture client (synthetic, not
# recorded from the real API): the same request/response shapes as far as we know them, no
# network. The README says exactly where that differs.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Anthropic (the two LLM call sites) ----------------------------------------
# Leave blank and every LLM path degrades deterministically: unmapped failures go
# to the human queue, nudges come from per-class templates. Nothing blocks on it.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_TIMEOUT_SECONDS=8

# ---- Storage -------------------------------------------------------------------
# SQLite by default. docker-compose.yml provides Postgres:
#   DATABASE_URL=postgresql+psycopg2://recovery:recovery@localhost:5432/recovery
DATABASE_URL=sqlite:///./recovery.db

# ---- Recovery link behaviour ---------------------------------------------------
RECOVERY_LINK_EXPIRY_HOURS=72
# Where Razorpay sends the customer after paying the recovery link (optional).
CALLBACK_URL=
# 1 = ask Razorpay to SMS/email the link to the customer on the event (notify + reminders).
# Off by default: the seed events carry realistic-looking contacts, and in live test mode
# Razorpay would message them. The agent's own nudge is drafted and stored, never sent.
RAZORPAY_NOTIFY_CUSTOMER=0

# ---- Webhook receiver (serve-webhook / ingest --signature) ---------------------
# Dashboard -> Settings -> Webhooks -> Add New Webhook: the "Secret" you choose there. When set,
# every POST to /razorpay/webhook must carry a matching X-Razorpay-Signature or it is refused (401).
# Leave blank to accept unsigned payloads (local files, curl); serve-webhook then warns at startup.
RAZORPAY_WEBHOOK_SECRET=

# ---- LLM prompt and nudge language (docs/llm.md) --------------------------------
# Not declared in app/config.py yet: app/llm.py and app/nudge_templates.py read a declared
# config attribute first, then the environment, then the default shown here.
# Labelled examples per failure class rendered into the cached classification prompt, taken
# from tests/fixtures/failure_cases.json (first ids per class, sorted; never random). 0 = none.
LLM_FEW_SHOT_PER_CLASS=2
# Language of the customer message when the attempt carries no customer_language and the
# caller passes none: en (Indian English), hi (Hindi, Devanagari) or hinglish (romanised Hindi).
NUDGE_LANGUAGE_DEFAULT=en

# ---- The money path (docs/money_path.md) --------------------------------------
# Ask Razorpay for captured payments on the order (GET /orders/{id}/payments) before creating a
# link. auto = on with real test keys, off against the fixture; 1/0 force it either way.
CHECK_ORDER_BEFORE_SEND=auto
# INSUFFICIENT_FUNDS sends that would land on the 24th..31st move to this day of the next month,
# 10:00 IST (a salary-cycle heuristic, see app/scheduling.py).
SALARY_WINDOW_DAY=2
# Link/nudge sends per customer phone or email in a rolling 7 days; beyond it a person decides.
# Reminders of a sent link (below) count too.
MAX_CONTACTS_PER_CUSTOMER_PER_WEEK=3

# ---- Delivery and reminder cadence (docs/delivery.md) ---------------------------
# 1 = after a link is sent, schedule the per-class reminders from app/cadence.py (e.g. INSUFFICIENT_FUNDS
# at +24h and +60h). Each reminder is POST /payment_links/{id}/notify_by/{sms|email}: Razorpay re-sends
# its own link message; it goes out only when RAZORPAY_NOTIFY_CUSTOMER=1, otherwise the reminder job
# completes as no_action with an audit row. 0 = no reminder jobs are created.
REMINDERS_ENABLED=1

# ---- Per-merchant policy overrides (docs/merchants.md) ---------------------------
# Not declared in app/config.py yet: app/merchants.py reads a declared config attribute first,
# then the environment, then the default shown here. Directory of <merchant_id>.json files
# (plus an optional _default.json every merchant inherits); files starting with "_" other than
# _default.json are documentation and skipped. A malformed file stops the CLI and the operator
# view with exit 1; a missing directory means "table defaults for every merchant".
MERCHANTS_DIR=merchants

# ---- Running it as a product (docs/ops.md: pra init / doctor / serve / digest) -----------------
# live = the executor makes the (test-mode) Razorpay calls. shadow = everything runs and is recorded,
# but no outbound call is made and jobs are marked `shadow`. Start in shadow; flip to live when the
# digest looks right.
PRA_MODE=live
# When set, the operator view (pra serve --web-port / python -m app.web) requires this bearer token.
OPERATOR_TOKEN=
# Slack-compatible incoming webhook URL. `pra digest --post`, `pra alert-test` and the human-queue
# alerts from `pra serve` POST {"text": ...} here. Blank = printed to stdout only.
ALERT_WEBHOOK_URL=
# Local time on digests. Asia/Kolkata is a fixed +05:30 offset (no tz database needed).
DIGEST_TIMEZONE=Asia/Kolkata

# ---- Recording and replaying the model path (docs/llm.md) -----------------------
# Not declared in app/config.py: app/llm_cassette.py reads a declared config attribute first,
# then the environment, then the default. off = the live client as-is. record = with a key, every
# model call is appended to the cassette (prompts verbatim; they carry no contact details by
# design). replay = answers come from the cassette and NOTHING reaches the network, key or no
# key; a request that was never recorded degrades to llm_cassette_miss->human_queue / ->template.
# The repository ships with no cassette: record one with
#   LLM_CASSETTE_MODE=record ANTHROPIC_API_KEY=... python scripts/eval_llm.py --record
LLM_CASSETTE_MODE=off
LLM_CASSETTE_PATH=tests/fixtures/llm_cassettes/default.jsonl

# ---- Offers, repeat-failer memory and shadow mode (docs/offers.md) ---------------
# app/offers.py reads a declared config attribute first, then the environment, then the default.
# shadow = decide, schedule and audit everything, send nothing: link jobs end `shadow` with the
# exact POST /payment_links payload in the audit row; reminders, notifies and cancels are recorded
# as "would have". live (default) = the normal money path.
PRA_MODE=live
# The partial-payment offer on INSUFFICIENT_FUNDS / LIMIT_EXCEEDED: only for amounts at or above
# this (paise; 200000 = Rs 2,000), asking for at least this share of the amount (whole rupees,
# never below Rs 100) as the first part.
PARTIAL_OFFER_MIN_PAISE=200000
PARTIAL_OFFER_MIN_SHARE=0.5
# Days of the same customer's history (same merchant, same phone or email) the repeat-failer rules read.
REPEAT_FAILER_WINDOW_DAYS=60
